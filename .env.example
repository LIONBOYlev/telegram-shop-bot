# Token from @BotFather
BOT_TOKEN=123456789:replace-with-your-token

# Where new orders are sent. Your own Telegram user ID, or a group ID (starts with -100...).
# Don't know it? Start the bot and send /id to it.
ADMIN_CHAT_ID=

# Shown before prices, e.g. $, €, ֏
CURRENCY=$

# Folder for orders and saved carts (relative to the project folder)
DATA_DIR=data
